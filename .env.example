# Copy to .env.local for local dev. On Railway these go in service Variables.

# On Railway, set this to the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:password@localhost:5432/academic_rivals

# The shared password everyone in the group types to get in. This is the real door.
GROUP_CODE=change-me

# Random string, 16+ chars. Signs session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-something-random

# One shared clock, so "what day is it" is never ambiguous between rivals.
APP_TIMEZONE=America/New_York
